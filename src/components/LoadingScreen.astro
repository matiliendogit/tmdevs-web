---
import tmdevsLogoBlack from '../assets/tmdevs-logo-black.png';
---

<!--
  Loading screen — static HTML rendered before React/Astro hydration.

  Animation strategy:
  - Entrance: animate-logo-enter — keyframe defined in global.css
              (opacity + blur 8px→0 + translateY + scale), 2s ease-out, delay 1s.
  - Exit:     Tailwind transition-opacity, triggered by JS adding .is-hidden
-->
<div
  id="tm-loading"
  role="progressbar"
  aria-label="Cargando tm.devs"
  aria-valuemin="0"
  aria-valuemax="100"
  class="fixed inset-0 z-999999 bg-white flex items-center justify-center transition-opacity duration-1400"
>
  <img
    src={tmdevsLogoBlack.src}
    alt="tm.devs digital lab"
    width={tmdevsLogoBlack.width}
    height={tmdevsLogoBlack.height}
    class="block h-auto w-[clamp(160px,30vw,240px)]"
  />
</div>

<style is:global>
  @keyframes logo-enter {
    from {
      opacity: 0;
      filter: blur(8px);
      transform: scale(0.96) translateY(6px);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: scale(1) translateY(0);
    }
  }

  /* Entrance — 1s delay, fill-mode backwards keeps opacity:0 durante el delay */
  #tm-loading img {
    animation: logo-enter 2s cubic-bezier(0.19, 1, 0.22, 1) 1s backwards;
  }

  /* JS-triggered exit — opacity toggle driven by classList.add('is-hidden') */
  #tm-loading.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    #tm-loading img {
      animation: none;
      opacity: 1;
      filter: none;
      transform: none;
    }
  }
</style>

<!--
  is:inline — executes immediately when parsed, before Astro's bundled scripts load.
  Required so scroll lock activates as early as possible.
  IIFE prevents global scope pollution.
-->
<script is:inline>
  (function () {
    const MIN_MS = 4000;
    const el = document.getElementById('tm-loading');
    let pageLoaded = false;
    let timerDone = false;

    document.body.style.overflow = 'hidden';

    function dismiss() {
      if (!pageLoaded || !timerDone || !el) return;
      el.classList.add('is-hidden');
      document.body.style.overflow = '';
      // Remove from DOM after transition so it no longer blocks the a11y tree
      el.addEventListener('transitionend', () => {
        el.remove();
        window.__tmLoadingDone = true;
        window.dispatchEvent(new CustomEvent('tmLoadingDone'));
      }, { once: true });
    }

    // Minimum display time
    setTimeout(function () {
      timerDone = true;
      dismiss();
    }, MIN_MS);

    // Wait for all resources: images, fonts, async scripts
    if (document.readyState === 'complete') {
      pageLoaded = true;
      dismiss();
    } else {
      window.addEventListener('load', function () {
        pageLoaded = true;
        dismiss();
      });
    }
  })();
</script>
